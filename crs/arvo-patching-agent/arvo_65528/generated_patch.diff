 // Checks if a + b > size, taking possible integer overflow into account.
 Status CheckOutOfBounds(size_t a, size_t b, size_t size) {
+  // Require at least one valid byte when b > 0, and reject overflow.
+  if (a >= size && b > 0) return JXL_FAILURE("Out of bounds");
   size_t pos = a + b;
-  if (pos > size) return JXL_FAILURE("Out of bounds");
-  if (pos < a) return JXL_FAILURE("Out of bounds");  // overflow happened
+  if (pos > size || pos < a) return JXL_FAILURE("Out of bounds");
   return true;
 }
 
