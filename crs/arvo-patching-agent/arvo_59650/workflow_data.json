    "patch": "--- a/Packet++/header/TLVData.h\n+++ b/Packet++/header/TLVData.h\n@@ -285,19 +285,34 @@\n \t\t{\n \t\t\tTLVRecordType resRec(NULL); // for NRVO optimization\n \n-\t\t\tif (record.isNull())\n+\t\t\tif (record.isNull() || tlvDataBasePtr == NULL)\n \t\t\t\treturn resRec;\n \n \t\t\t// record pointer is out-bounds of the TLV records memory\n-\t\t\tif ((record.getRecordBasePtr() - tlvDataBasePtr) < 0)\n+\t\t\tif (record.getRecordBasePtr() < tlvDataBasePtr)\n \t\t\t\treturn resRec;\n \n-\t\t\t// record pointer is out-bounds of the TLV records memory\n-\t\t\tif (record.getRecordBasePtr() - tlvDataBasePtr + (int)record.getTotalSize() >= (int)tlvDataLen)\n+\t\t\tconst size_t recordOffset = static_cast<size_t>(record.getRecordBasePtr() - tlvDataBasePtr);\n+\t\t\tconst size_t recordSize = record.getTotalSize();\n+\t\t\t// Validate using subtraction to avoid overflowing when the record declares a very large size.\n+\t\t\t// There must also be at least one byte following this record for another record to exist.\n+\t\t\tif (recordOffset >= tlvDataLen || recordSize >= tlvDataLen - recordOffset)\n+\t\t\t\treturn resRec;\n+\n+\t\t\tresRec.assign(record.getRecordBasePtr() + recordSize);\n+\t\t\tif (resRec.isNull())\n \t\t\t\treturn resRec;\n \n-\t\t\tresRec.assign(record.getRecordBasePtr() + record.getTotalSize());\n-\t\t\tif (resRec.getTotalSize() == 0)\n+\t\t\t// assign() may adjust the record pointer (for example, to skip protocol padding),\n+\t\t\t// so calculate the actual returned record's offset and validate its declared size.\n+\t\t\tif (resRec.getRecordBasePtr() < tlvDataBasePtr)\n+\t\t\t{\n+\t\t\t\tresRec.assign(NULL);\n+\t\t\t\treturn resRec;\n+\t\t\t}\n+\t\t\tconst size_t resOffset = static_cast<size_t>(resRec.getRecordBasePtr() - tlvDataBasePtr);\n+\t\t\tif (resOffset >= tlvDataLen || resRec.getTotalSize() == 0 ||\n+\t\t\t\tresRec.getTotalSize() > tlvDataLen - resOffset)\n \t\t\t\tresRec.assign(NULL);\n \n \t\t\treturn resRec;\n",
