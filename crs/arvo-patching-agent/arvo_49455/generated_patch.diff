--- a/src/cmsopt.c
+++ b/src/cmsopt.c
@@ -676,6 +676,13 @@
 
     Src = *Lut;
 
+    // Tetrahedral interpolation for 16-bit CLUT assumes at least 2 grid points
+    // per input dimension so neighboring vertices exist. Degenerate 1-point CLUTs
+    // can lead to invalid neighbor offsets and out-of-bounds reads.
+    if (Src->InputChannels == 3 && nGridPoints < 2) {
+        nGridPoints = 2;
+    }
+
     // Allocate an empty LUT
     Dest =  cmsPipelineAlloc(Src ->ContextID, Src ->InputChannels, Src ->OutputChannels);
     if (!Dest) return FALSE;
