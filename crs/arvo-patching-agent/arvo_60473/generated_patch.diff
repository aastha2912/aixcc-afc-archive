+// Validate a DNS name before creating an IDnsResource. In addition to validating
+// the bytes occupied by the name at its current location, follow compression
+// pointers so malformed/truncated pointed-to names aren't accepted.
+bool validateDnsName(const uint8_t* data, size_t dataLen, size_t offsetAdjustment,
+					size_t nameOffset, size_t& encodedNameLen, size_t& expandedNameLen,
+					unsigned int recursionDepth)
+{
+	if (recursionDepth > 20 || nameOffset >= dataLen)
+		return false;
+
+	size_t currentOffset = nameOffset;
+	while (currentOffset < dataLen)
+	{
+		uint8_t labelLength = data[currentOffset];
+		if (labelLength == 0)
+		{
+			if (expandedNameLen >= 255)
+				return false;
+			expandedNameLen++;
+			encodedNameLen = currentOffset - nameOffset + 1;
+			return true;
+		}
+
+		if ((labelLength & 0xc0) == 0xc0)
+		{
+			if (dataLen - currentOffset < sizeof(uint16_t))
+				return false;
+
+			size_t pointerOffset = offsetAdjustment +
+					(((size_t)labelLength & 0x3f) << 8) + data[currentOffset + 1];
+			if (pointerOffset < offsetAdjustment + sizeof(dnshdr) || pointerOffset >= dataLen)
+				return false;
+
+			size_t pointedNameLen = 0;
+			if (!validateDnsName(data, dataLen, offsetAdjustment, pointerOffset, pointedNameLen,
+							expandedNameLen, recursionDepth + 1))
+				return false;
+
+			encodedNameLen = currentOffset - nameOffset + sizeof(uint16_t);
+			return true;
+		}
+
+		// The two high bits are reserved for label types and a label is at most 63 bytes.
+		if ((labelLength & 0xc0) != 0 || dataLen - currentOffset - 1 < labelLength ||
+			expandedNameLen > 255 - labelLength - 1)
+			return false;
+
+		expandedNameLen += labelLength + 1;
+		currentOffset += labelLength + 1;
+	}
+
+	return false;
+}
+
+} // anonymous namespace
