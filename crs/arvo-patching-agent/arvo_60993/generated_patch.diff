--- a/libredwg/src/bits.c
+++ b/libredwg/src/bits.c
@@ -194,7 +194,17 @@
   unsigned char result;
   unsigned char byte;
 
-  CHK_OVERFLOW (__FUNCTION__, 0)
+  /* Unlike CHK_OVERFLOW, this must also reject the valid end cursor and a
+     cursor at the last bit of the buffer: this read requires two bits.  Keep
+     the check in bytes to avoid overflow in size * 8 arithmetic. */
+  if (dat->byte >= dat->size || dat->bit >= 8
+      || (dat->byte == dat->size - 1 && dat->bit > 6))
+    {
+      loglevel = dat->opts & DWG_OPTS_LOGLEVEL;
+      LOG_ERROR ("%s buffer overflow at %" PRIuSIZE ".%u, size %" PRIuSIZE,
+                 __FUNCTION__, dat->byte, dat->bit, dat->size)
+      return 0;
+    }
   byte = dat->chain[dat->byte];
   if (dat->bit < 7)
     result = (byte & (0xc0 >> dat->bit)) >> (6 - dat->bit);
