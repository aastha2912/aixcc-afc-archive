--- a/arrow/cpp/src/arrow/ipc/reader.cc
+++ b/arrow/cpp/src/arrow/ipc/reader.cc
@@ -823,6 +823,11 @@
 
   // swap endian in dict_data if necessary (swap_endian == true)
   if (context.swap_endian) {
+    // ArrayDataEndianSwapper operates on complete physical values.  Reject malformed
+    // IPC metadata before swapping so an advertised logical length cannot exceed the
+    // dictionary's value buffer.
+    RETURN_NOT_OK(MakeArray(dict_data)->Validate().WithMessage(
+        "Invalid dictionary data before endian conversion: "));
     ARROW_ASSIGN_OR_RAISE(dict_data, ::arrow::internal::SwapEndianArrayData(dict_data));
   }
 
