+namespace {
+
+// MakeArray assumes that dictionary data has already been resolved and the
+// DictionaryArray constructor enforces this with a fatal check.  Dictionary
+// batches, however, may temporarily contain unresolved nested dictionaries,
+// so inspect the ArrayData tree before boxing it.
+Status CheckDictionariesResolved(const std::shared_ptr<ArrayData>& data) {
+  if (data == nullptr || data->type == nullptr) {
+    return Status::Invalid("Dictionary delta contains null array data");
+  }
+  if (data->type->layout().has_dictionary && data->dictionary == nullptr) {
+    return Status::Invalid("Dictionary delta contains an unresolved dictionary of type ",
+                           data->type->ToString());
+  }
+  for (const auto& child : data->child_data) {
+    RETURN_NOT_OK(CheckDictionariesResolved(child));
+  }
+  if (data->dictionary != nullptr) {
+    RETURN_NOT_OK(CheckDictionariesResolved(data->dictionary));
+  }
+  return Status::OK();
+}
+
+}  // namespace
