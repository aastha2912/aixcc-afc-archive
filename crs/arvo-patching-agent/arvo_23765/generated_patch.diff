--- a/buf.c
+++ b/buf.c
@@ -1329,12 +1329,16 @@
  * Update the input to use the base and cur relative to the buffer
  * after a possible reallocation of its content
  *
+ * This also works if the buffer is in an error state. Its allocation and
+ * current contents are still valid and parser input pointers must be kept in
+ * sync after a failed operation which reallocated the buffer.
+ *
  * Returns -1 in case of error, 0 otherwise
  */
 int
 xmlBufSetInputBaseCur(xmlBufPtr buf, xmlParserInputPtr input,
                       size_t base, size_t cur) {
-    if ((input == NULL) || (buf == NULL) || (buf->error))
+    if ((input == NULL) || (buf == NULL))
         return(-1);
     CHECK_COMPAT(buf)
     input->base = &buf->content[base];
--- a/HTMLparser.c
+++ b/HTMLparser.c
@@ -6136,12 +6136,12 @@
 	int res;
 
 	res = xmlParserInputBufferPush(ctxt->input->buf, size, chunk);
+	xmlBufSetInputBaseCur(ctxt->input->buf->buffer, ctxt->input, base, cur);
 	if (res < 0) {
 	    ctxt->errNo = XML_PARSER_EOF;
 	    ctxt->disableSAX = 1;
 	    return (XML_PARSER_EOF);
 	}
-        xmlBufSetInputBaseCur(ctxt->input->buf->buffer, ctxt->input, base, cur);
 #ifdef DEBUG_PUSH
 	xmlGenericError(xmlGenericErrorContext, "HPP: pushed %d\n", size);
 #endif
