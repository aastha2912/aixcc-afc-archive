+static bool getDnsNameLength(const uint8_t* data, size_t dataLen, size_t offset,
+							 size_t offsetAdjustment, size_t& nameLength)
+{
+	nameLength = 0;
+
+	while (true)
+	{
+		if (offset >= dataLen || nameLength >= 255)
+			return false;
+
+		uint8_t labelLength = data[offset];
+		if (labelLength == 0)
+		{
+			nameLength++;
+			return true;
+		}
+
+		if ((labelLength & 0xc0) == 0xc0)
+		{
+			if (dataLen - offset < sizeof(uint16_t) || nameLength > 253)
+				return false;
+
+			size_t pointerOffset = ((labelLength & 0x3f) << 8) | data[offset + 1];
+			pointerOffset += offsetAdjustment;
+			if (pointerOffset < sizeof(dnshdr) || pointerOffset >= dataLen)
+				return false;
+
+			nameLength += sizeof(uint16_t);
+			return true;
+		}
+
+		// The other two high-bit combinations are reserved, and a DNS label is at most 63 bytes.
+		if ((labelLength & 0xc0) != 0)
+			return false;
+
+		size_t encodedLabelLength = static_cast<size_t>(labelLength) + 1;
+		if (encodedLabelLength > dataLen - offset || encodedLabelLength > 255 - nameLength)
+			return false;
+
+		offset += encodedLabelLength;
+		nameLength += encodedLabelLength;
+	}
+}
