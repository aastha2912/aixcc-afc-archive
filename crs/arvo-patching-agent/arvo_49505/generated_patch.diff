 // Enforces that the profile version is per. spec.
 // Operates on the big endian bytes from the profile.
 // Called before converting to platform endianness.
+
+// Check whether a tag type can be represented by a tag descriptor. This is
+// also used while building links, before any tag data has been cooked.
+static
+cmsBool IsTypeSupportedByDescriptor(const cmsTagDescriptor* TagDescriptor, cmsTagTypeSignature Type)
+{
+    cmsUInt32Number i, nMaxTypes;
+
+    if (TagDescriptor == NULL) return FALSE;
+
+    nMaxTypes = TagDescriptor->nSupportedTypes;
+    if (nMaxTypes >= MAX_TYPES_IN_LCMS_PLUGIN)
+        nMaxTypes = MAX_TYPES_IN_LCMS_PLUGIN;
+
+    for (i = 0; i < nMaxTypes; i++) {
+        if (Type == TagDescriptor->SupportedTypes[i]) return TRUE;
+    }
+
+    return FALSE;
+}
+
+// Linked tags share the same cooked object. Therefore both tag signatures
+// must accept the actual type stored in the shared block and must agree on
+// the number of elements represented by that object.
+static
+cmsBool AreTagDescriptorsCompatible(_cmsICCPROFILE* Icc, cmsTagSignature First,
+                                    cmsTagSignature Second, cmsTagTypeSignature Type)
+{
+    cmsTagDescriptor* FirstDescriptor  = _cmsGetTagDescriptor(Icc->ContextID, First);
+    cmsTagDescriptor* SecondDescriptor = _cmsGetTagDescriptor(Icc->ContextID, Second);
+
+    if (FirstDescriptor == NULL || SecondDescriptor == NULL) return FALSE;
+    if (FirstDescriptor->ElemCount != SecondDescriptor->ElemCount) return FALSE;
+
+    return IsTypeSupportedByDescriptor(FirstDescriptor, Type) &&
+           IsTypeSupportedByDescriptor(SecondDescriptor, Type);
+}
+
