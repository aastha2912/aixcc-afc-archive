    "decoding": "<pov_script>\n\n# Use embedded PoC data\npoc_data = b'rule r{strings:$=/.{,}?/'\n\nwith open(\"input.bin\", \"wb\") as f:\n    f.write(poc_data)\n\n</pov_script>\n",
