--- a/gpac/src/isomedia/box_funcs.c
+++ b/gpac/src/isomedia/box_funcs.c
@@ -325,10 +325,19 @@
 		is_special = GF_FALSE;
 		newBox = gf_isom_box_new_ex(uuid_type ? uuid_type : type, parent_type, skip_logs, is_root_box);
 		if (!newBox) ERR_EXIT(GF_OUT_OF_MEM);
+		/* A known UUID may only be valid under specific parents. In that case
+		 * gf_isom_box_new_ex() falls back to GF_UnknownBox, which is not layout
+		 * compatible with GF_UUIDBox. Preserve the on-wire UUID semantics by
+		 * replacing that fallback with the generic UUID box. */
+		if ((type == GF_ISOM_BOX_TYPE_UUID) && (newBox->type != GF_ISOM_BOX_TYPE_UUID)) {
+			gf_isom_box_del(newBox);
+			newBox = gf_isom_box_new_ex(GF_ISOM_BOX_TYPE_UUID, parent_type, skip_logs, is_root_box);
+			if (!newBox) ERR_EXIT(GF_OUT_OF_MEM);
+		}
 	}
 
 	//OK, init and read this box
-	if (type==GF_ISOM_BOX_TYPE_UUID && !is_special) {
+	if ((type==GF_ISOM_BOX_TYPE_UUID) && !is_special && (newBox->type==GF_ISOM_BOX_TYPE_UUID)) {
 		memcpy(((GF_UUIDBox *)newBox)->uuid, uuid, 16);
 		((GF_UUIDBox *)newBox)->internal_4cc = uuid_type;
 	}
