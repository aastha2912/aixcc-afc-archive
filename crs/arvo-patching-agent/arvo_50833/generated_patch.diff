--- a/src/cmspack.c
+++ b/src/cmspack.c
@@ -4010,6 +4010,12 @@
 // Return whatever given formatter refers to float values
 cmsBool  _cmsFormatterIsFloat(cmsUInt32Number Type)
 {
+    // Zero is not a complete raster format. Classifying it here makes transform
+    // creation take the formatter-validation path, which rejects the missing
+    // callback instead of creating an executable transform with NULL formatters.
+    if (Type == 0)
+        return TRUE;
+
     return T_FLOAT(Type) ? TRUE : FALSE;
 }
 
