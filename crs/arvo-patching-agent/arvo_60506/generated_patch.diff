+            remaining = (Dwarf_Unsigned)(line_ptr_end - prologue_start);
+            if (line_context->lc_actuals_table_offset > remaining ||
+                line_context->lc_actuals_table_offset <
+                    line_context->lc_logicals_table_offset) {
+                dwarf_srclines_dealloc_b(line_context);
+                _dwarf_error(dbg, error, DW_DLE_LINE_OFFSET_BAD);
+                return DW_DLV_ERROR;
+            }
+            line_ptr_actuals = prologue_start +
                 line_context->lc_actuals_table_offset;
+            if (line_ptr_actuals < line_ptr) {
+                dwarf_srclines_dealloc_b(line_context);
+                _dwarf_error(dbg, error, DW_DLE_LINE_OFFSET_BAD);
+                return DW_DLV_ERROR;
+            }
         }
     }
