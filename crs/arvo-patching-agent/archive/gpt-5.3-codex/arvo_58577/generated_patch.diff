--- a/mruby/src/gc.c
+++ b/mruby/src/gc.c
@@ -1027,6 +1027,33 @@
   gc->live_after_mark = gc->live;
 }
 
+static void
+unlink_gray_list_in_page(struct RBasic **list, mrb_heap_page *page)
+{
+  struct RBasic *obj = *list;
+  struct RBasic *prev = NULL;
+  RVALUE *start = page->objects;
+  RVALUE *end = start + MRB_HEAP_PAGE_SIZE;
+
+  while (obj) {
+    struct RBasic *next = obj->gcnext;
+    RVALUE *slot = (RVALUE*)obj;
+
+    if (slot >= start && slot < end) {
+      if (prev) {
+        prev->gcnext = next;
+      }
+      else {
+        *list = next;
+      }
+    }
+    else {
+      prev = obj;
+    }
+    obj = next;
+  }
+}
+
 static size_t
 incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
 {
