--- a/mruby/mrbgems/mruby-class-ext/src/class.c
+++ b/mruby/mrbgems/mruby-class-ext/src/class.c
@@ -99,14 +99,21 @@
 {
   struct RClass *c;
   mrb_value ary;
+  mrb_gc_arena_save_point ai;
 
   c = mrb_class_ptr(self);
   ary = mrb_ary_new(mrb);
+  ai = mrb_gc_arena_save(mrb);
 
   if (c->flags & MRB_FL_CLASS_IS_INHERITED) {
     struct subclass_args arg = {c, ary};
     mrb_objspace_each_objects(mrb, add_subclasses, &arg);
   }
+
+  /* mrb_objspace_each_objects may trigger full GC; keep the return value
+   * and its elements strongly reachable across that phase. */
+  mrb_gc_protect(mrb, ary);
+  mrb_gc_arena_restore(mrb, ai);
   return ary;
 }
 
