--- a/src/pkcs15init/pkcs15-lib.c
+++ b/src/pkcs15init/pkcs15-lib.c
@@ -1566,6 +1566,13 @@
 	LOG_TEST_GOTO_ERR(ctx, r, "Set up private key object error");
 
 	key_info = (struct sc_pkcs15_prkey_info *) object->data;
+	/*
+	 * Defensive initialization: on fuzzed/malformed profiles, object->data may
+	 * be only partially initialized when we jump to err: and free the object.
+	 * Ensure aux_data starts from a known-safe state so sc_pkcs15_free_object()
+	 * cannot pass a garbage pointer to sc_aux_data_free().
+	 */
+	key_info->aux_data = NULL;
 
 	r = _pkcd15init_set_aux_md_data(p15card, &key_info->aux_data,
 			keygen_args->prkey_args.guid, keygen_args->prkey_args.guid_len);
