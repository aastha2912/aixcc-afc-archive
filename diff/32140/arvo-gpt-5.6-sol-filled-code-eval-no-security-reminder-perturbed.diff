+/* Compute the size of the four per-thread work buffers without allowing
+ * either the signed sub-buffer size or the allocation size to wrap. */
+static int get_tmp_sizes(int32_t blocksize, int32_t typesize,
+                         int32_t* ebsize, size_t* tmp_nbytes) {
+  size_t extra;
+  size_t extended_blocksize;
+
+  if (blocksize <= 0 || typesize <= 0) {
+    return BLOSC2_ERROR_INVALID_PARAM;
+  }
+
+  extra = (size_t)typesize * sizeof(int32_t);
+  if (extra > (size_t)INT32_MAX ||
+      (size_t)blocksize > (size_t)INT32_MAX - extra) {
+    return BLOSC2_ERROR_INVALID_PARAM;
+  }
+  extended_blocksize = (size_t)blocksize + extra;
+  if (extended_blocksize > (size_t)-1 / 4) {
+    return BLOSC2_ERROR_INVALID_PARAM;
+  }
+
+  *ebsize = (int32_t)extended_blocksize;
+  *tmp_nbytes = extended_blocksize * 4;
+  return 0;
+}
