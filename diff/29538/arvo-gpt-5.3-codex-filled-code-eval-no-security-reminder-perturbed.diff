--- a/ext/hash/hash.c
+++ b/ext/hash/hash.c
@@ -341,9 +341,31 @@
 
 PHP_HASH_API int php_hash_unserialize(php_hashcontext_object *hash, zend_long magic, const zval *zv) /* {{{ */
 {
+	int ret;
+
 	if (hash->ops->serialize_spec
 		&& magic == PHP_HASH_SERIALIZE_MAGIC_SPEC) {
-		return php_hash_unserialize_spec(hash, zv, hash->ops->serialize_spec);
+		ret = php_hash_unserialize_spec(hash, zv, hash->ops->serialize_spec);
+		if (ret != SUCCESS) {
+			return ret;
+		}
+
+		/* Restore-state invariants for xxHash contexts.
+		 * XXH*_update() assumes memsize is bounded by the internal buffer size.
+		 * Reject forged serialized states that violate these invariants. */
+		if (hash->ops == &php_hash_xxh32_ops) {
+			PHP_XXH32_CTX *ctx = (PHP_XXH32_CTX *) hash->context;
+			if (ctx->s.memsize > sizeof(ctx->s.mem32)) {
+				return FAILURE;
+			}
+		} else if (hash->ops == &php_hash_xxh64_ops) {
+			PHP_XXH64_CTX *ctx = (PHP_XXH64_CTX *) hash->context;
+			if (ctx->s.memsize > sizeof(ctx->s.mem64)) {
+				return FAILURE;
+			}
+		}
+
+		return SUCCESS;
 	} else {
 		return FAILURE;
 	}
