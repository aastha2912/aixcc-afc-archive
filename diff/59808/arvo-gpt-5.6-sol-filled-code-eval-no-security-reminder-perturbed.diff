+	 */
+	void parseFieldsWithSafeOffsets()
+	{
+		const size_t dataLen = m_DataLen;
+		const size_t maxOffset = static_cast<size_t>(std::numeric_limits<int>::max());
+		if (m_DataLen > maxOffset)
+			m_DataLen = maxOffset;
+
+		parseFields();
+		m_DataLen = dataLen;
+	}
