+static int __cil_init_avtab_key(avtab_key_t *avtab_key, uint32_t src,
+				uint32_t tgt, uint32_t obj)
+{
+	/*
+	 * Symbol values are 32 bits in policydb, but the corresponding avtab
+	 * key fields are only 16 bits.  Reject values that cannot be represented
+	 * instead of silently constructing a wrapped (and possibly zero) key.
+	 */
+	if (src == 0 || src > UINT16_MAX ||
+	    tgt == 0 || tgt > UINT16_MAX ||
+	    obj == 0 || obj > UINT16_MAX) {
+		cil_log(CIL_ERR, "AV rule key is outside the supported range\n");
+		return SEPOL_ERR;
+	}
+
+	avtab_key->source_type = src;
+	avtab_key->target_type = tgt;
+	avtab_key->target_class = obj;
+	return SEPOL_OK;
+}
