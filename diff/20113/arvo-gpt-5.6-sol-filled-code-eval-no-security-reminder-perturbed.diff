   Status Visit(const UnionArray& array) {
+    // The raw union buffer pointers account for array.offset(), so each backing
+    // buffer must cover all physical slots through offset + length.  Check this
+    // before full validation dereferences either pointer.
+    if (array.length() > 0) {
+      if (array.offset() < 0) {
+        return Status::Invalid("Union array offset is negative");
+      }
+
+      const auto type_codes = array.type_codes();
+      if (type_codes == nullptr) {
+        return Status::Invalid("non-empty union array but type codes buffer is null");
+      }
+      const int64_t type_code_capacity =
+          type_codes->size() / static_cast<int64_t>(sizeof(UnionArray::type_code_t));
+      if (array.offset() > type_code_capacity ||
+          array.length() > type_code_capacity - array.offset()) {
+        return Status::Invalid("Union type codes buffer size (bytes): ",
+                               type_codes->size(),
+                               " isn't large enough for length: ", array.length(),
+                               " and offset: ", array.offset());
+      }
+
+      if (array.mode() == UnionMode::DENSE) {
+        const auto value_offsets = array.value_offsets();
+        if (value_offsets == nullptr) {
+          return Status::Invalid(
+              "non-empty dense union array but value offsets buffer is null");
+        }
+        const int64_t value_offset_capacity =
+            value_offsets->size() / static_cast<int64_t>(sizeof(int32_t));
+        if (array.offset() > value_offset_capacity ||
+            array.length() > value_offset_capacity - array.offset()) {
+          return Status::Invalid("Dense union value offsets buffer size (bytes): ",
+                                 value_offsets->size(),
+                                 " isn't large enough for length: ", array.length(),
+                                 " and offset: ", array.offset());
+        }
+      }
+    }
+
     const auto& union_type = *array.union_type();
     // Validate fields
     for (int i = 0; i < array.num_fields(); ++i) {
