   Status Visit(const UnionArray& array) {
+    if (array.null_count() != 0) {
+      const auto null_bitmap = array.null_bitmap();
+      if (null_bitmap == nullptr) {
+        return Status::Invalid("Union array has nulls but no null bitmap");
+      }
+      const int64_t min_bitmap_bytes = bit_util::BytesForBits(array.offset() + array.length());
+      if (null_bitmap->size() < min_bitmap_bytes) {
+        return Status::Invalid("Union array null bitmap is too small for array length");
+      }
+    }
     const auto& child_ids = array.union_type()->child_ids();
 
