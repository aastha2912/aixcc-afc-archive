 static void
+validate_irep(codegen_scope *s)
+{
+  mrb_irep *irep = s->irep;
+  uint32_t pc;
+
+  for (pc = 0; pc < s->pc; pc++) {
+    mrb_code insn = s->iseq[pc];
+    uint8_t op = GET_OPCODE(insn);
+    uint32_t b = 0;
+
+    switch (op) {
+    case OP_LOADL:
+    case OP_LOADL16:
+      b = GETARG_Bx(insn);
+      if (b >= irep->plen) {
+        codegen_error(s, "invalid OP_LOADL operand");
+      }
+      break;
+
+    case OP_LOADSYM:
+    case OP_GETGV:
+    case OP_SETGV:
+    case OP_GETSV:
+    case OP_SETSV:
+    case OP_GETIV:
+    case OP_SETIV:
+    case OP_GETCV:
+    case OP_SETCV:
+    case OP_GETCONST:
+    case OP_SETCONST:
+    case OP_GETMCNST:
+    case OP_SETMCNST:
+    case OP_SEND:
+    case OP_SENDB:
+    case OP_SENDV:
+    case OP_SUPER:
+    case OP_ARGARY:
+    case OP_ENTER:
+    case OP_KEY_P:
+    case OP_KARG:
+    case OP_SSEND:
+    case OP_SSENDB:
+      b = GETARG_B(insn);
+      if (b >= irep->slen) {
+        codegen_error(s, "invalid symbol operand");
+      }
+      break;
+
+    default:
+      break;
+    }
+  }
+}
