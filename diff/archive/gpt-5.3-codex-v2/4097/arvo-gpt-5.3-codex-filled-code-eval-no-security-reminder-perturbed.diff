--- a/src/server/ua_session_manager.c
+++ b/src/server/ua_session_manager.c
@@ -42,6 +42,14 @@
     /* Deactivate the session */
     sentry->session.activated = false;
 
+#ifdef UA_ENABLE_SUBSCRIPTIONS
+    /* Ensure callbacks and pending publish handling tied to the session are
+     * drained before the delayed free runs. Otherwise delayed publish paths can
+     * still dereference the session after removeSessionCallback frees it. */
+    UA_Session_deleteSubscription(&sentry->session, sm->server);
+    UA_Subscription_answerPublishRequestsNoSubscription(sm->server, &sentry->session);
+#endif
+
     /* Add a delayed callback to remove the session when the currently
      * scheduled jobs have completed */
     UA_StatusCode retval = UA_Server_delayedCallback(sm->server, removeSessionCallback, sentry);
