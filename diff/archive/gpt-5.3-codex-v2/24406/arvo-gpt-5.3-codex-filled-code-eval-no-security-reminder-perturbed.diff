--- a/Code/GraphMol/FileParsers/MolFileParser.cpp
+++ b/Code/GraphMol/FileParsers/MolFileParser.cpp
@@ -845,9 +845,19 @@
   if (m) {
     QueryAtom::QUERYATOM_QUERY *query = new RecursiveStructureQuery(m);
     if (!at->hasQuery()) {
+      // ParseMolBlockAtoms() bookmarks atoms by their molfile index and later
+      // SGroup parsing resolves atoms via those bookmarks. replaceAtom()
+      // deletes the old atom object, so we must remap any matching bookmark
+      // entries to the new atom pointer to avoid dangling references.
+      const int bookmark = static_cast<int>(idx + 1);
+      const bool hadBookmark = mol->hasAtomBookmark(bookmark);
       QueryAtom qAt(*at);
       int oidx = at->getIdx();
       mol->replaceAtom(oidx, &qAt);
+      if (hadBookmark) {
+        mol->clearAtomBookmark(bookmark);
+        mol->setAtomBookmark(mol->getAtomWithIdx(oidx), bookmark);
+      }
       at = mol->getAtomWithIdx(oidx);
     }
     at->expandQuery(query, Queries::COMPOSITE_AND);
