--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -286,6 +286,15 @@
 	EG(active) = 0;
 
 	if (!fast_shutdown) {
+		/* During shutdown after a bailout/unclean execution state, symbol table
+		 * entries may be corrupted. Using the normal destructor can dereference
+		 * invalid refcounted pointers while releasing zvals. Switch to the
+		 * unclean destructor in that case, which uses i_zval_ptr_dtor() and
+		 * avoids invoking user-level cleanup paths.
+		 */
+		if (CG(unclean_shutdown)) {
+			EG(symbol_table).pDestructor = zend_unclean_zval_ptr_dtor;
+		}
 		zend_hash_graceful_reverse_destroy(&EG(symbol_table));
 
 		/* Constants may contain objects, destroy them before the object store. */
