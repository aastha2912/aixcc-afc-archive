--- a/src/sksl/SkSLIRGenerator.cpp
+++ b/src/sksl/SkSLIRGenerator.cpp
@@ -1805,7 +1805,9 @@
 
     // Handle boolean operations: == !=
     if (op == Token::Kind::TK_EQEQ || op == Token::Kind::TK_NEQ) {
-        if (left.kind() == right.kind()) {
+        // Constant-compare only when both sides are the same kind and still valid compile-time
+        // constants; malformed expressions can produce stale IR nodes during recovery.
+        if (left.kind() == right.kind() && left.isCompileTimeConstant() && right.isCompileTimeConstant()) {
             bool result = left.compareConstant(fContext, right) ^ (op == Token::Kind::TK_NEQ);
             return std::make_unique<BoolLiteral>(fContext, left.fOffset, result);
         }
