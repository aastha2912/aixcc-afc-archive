   Status Visit(const UnionArray& array) {
+    const auto null_bitmap = array.null_bitmap();
+    if (null_bitmap != nullptr) {
+      const int64_t min_bitmap_bits = array.offset() + array.length();
+      const int64_t bitmap_bits = null_bitmap->size() * 8;
+      if (bitmap_bits < min_bitmap_bits) {
+        return Status::Invalid("Union array null bitmap size too small for length and ",
+                               "offset: ", bitmap_bits, " < ", min_bitmap_bits);
+      }
+    }
+
     const auto& child_ids = array.union_type()->child_ids();
 
