--- a/arrow/cpp/src/arrow/array/validate.cc
+++ b/arrow/cpp/src/arrow/array/validate.cc
@@ -264,6 +264,27 @@
     return Status::Invalid("Array length is negative");
   }
 
+  if (data.offset < 0) {
+    return Status::Invalid("Array offset is negative");
+  }
+
+  if (data.buffers.size() != layout.bit_widths.size()) {
+    return Status::Invalid("Expected ", layout.bit_widths.size(),
+                           " buffers in array "
+                           "of type ",
+                           type.ToString(), ", got ", data.buffers.size());
+  }
+
+  if (layout.bit_widths[0] == 1 && data.buffers[0]) {
+    const int64_t required_bits = data.offset + data.length;
+    if (required_bits < 0) {
+      return Status::Invalid("Array bitmap range is invalid");
+    }
+    if (data.buffers[0]->size() * 8 < required_bits) {
+      return Status::Invalid("Null bitmap buffer is too small for array length and offset");
+    }
+  }
+
   if (array.null_count() > array.length()) {
     return Status::Invalid("Null count exceeds array length");
   }
