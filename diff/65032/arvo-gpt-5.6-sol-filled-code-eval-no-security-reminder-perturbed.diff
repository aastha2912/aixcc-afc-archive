+/*
+ * Extract the encoding name from an ASCII XML declaration.  Non-ASCII
+ * encodings must be converted based on their signature before calling this
+ * function.
+ */
+static int
+xsltGetDeclaredEncoding(const xmlChar *data, size_t size, char *encoding,
+                        size_t encodingSize) {
+    size_t i, start;
+    int quote;
+
+    if ((data == NULL) || (encodingSize == 0))
+        return(0);
+    if ((size >= 3) && (data[0] == 0xEF) && (data[1] == 0xBB) &&
+        (data[2] == 0xBF)) {
+        data += 3;
+        size -= 3;
+    }
+    if ((size < 6) || (memcmp(data, "<?xml", 5) != 0) ||
+        ((data[5] != ' ') && (data[5] != '\t') &&
+         (data[5] != '\r') && (data[5] != '\n')))
+        return(0);
+
+    i = 6;
+    while (i < size) {
+        while ((i < size) && ((data[i] == ' ') || (data[i] == '\t') ||
+               (data[i] == '\r') || (data[i] == '\n')))
+            i++;
+        if ((i + 1 < size) && (data[i] == '?') && (data[i + 1] == '>'))
+            return(0);
+
+        start = i;
+        while ((i < size) && (((data[i] >= 'A') && (data[i] <= 'Z')) ||
+               ((data[i] >= 'a') && (data[i] <= 'z'))))
+            i++;
+        if (i == start)
+            return(0);
+
+        if (((i - start) == 8) &&
+            (memcmp(data + start, "encoding", 8) == 0)) {
+            while ((i < size) && ((data[i] == ' ') || (data[i] == '\t') ||
+                   (data[i] == '\r') || (data[i] == '\n')))
+                i++;
+            if ((i >= size) || (data[i++] != '='))
+                return(0);
+            while ((i < size) && ((data[i] == ' ') || (data[i] == '\t') ||
+                   (data[i] == '\r') || (data[i] == '\n')))
+                i++;
+            if ((i >= size) || ((data[i] != '\'') && (data[i] != '"')))
+                return(0);
+            quote = data[i++];
+            start = i;
+            while ((i < size) && (data[i] != quote) &&
+                   (((data[i] >= 'A') && (data[i] <= 'Z')) ||
+                    ((data[i] >= 'a') && (data[i] <= 'z')) ||
+                    ((data[i] >= '0') && (data[i] <= '9')) ||
+                    (data[i] == '.') || (data[i] == '_') ||
+                    (data[i] == '-')))
+                i++;
+            if ((i == start) || (i >= size) || (data[i] != quote) ||
+                (i - start >= encodingSize))
+                return(0);
+            memcpy(encoding, data + start, i - start);
+            encoding[i - start] = 0;
+            return(1);
+        }
+
+        while ((i < size) && (data[i] != ' ') && (data[i] != '\t') &&
+               (data[i] != '\r') && (data[i] != '\n') &&
+               !((data[i] == '?') && (i + 1 < size) && (data[i + 1] == '>')))
+            i++;
+    }
+    return(0);
+}
