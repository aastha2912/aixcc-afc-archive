--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -229,7 +229,19 @@
 	if (Z_TYPE_P(zv) == IS_INDIRECT) {
 		zv = Z_INDIRECT_P(zv);
 	}
-	i_zval_ptr_dtor(zv);
+	/* During unclean shutdown/fuzzed states we may observe corrupted zvals in
+	 * the symbol table. Avoid dereferencing an invalid GC pointer from
+	 * i_zval_ptr_dtor() by first validating the refcounted payload. */
+	if (Z_REFCOUNTED_P(zv)) {
+		zend_refcounted *ref = Z_COUNTED_P(zv);
+		if (EXPECTED(ref != NULL) && EXPECTED(GC_TYPE(ref) == Z_TYPE_P(zv))) {
+			i_zval_ptr_dtor(zv);
+		} else {
+			ZVAL_UNDEF(zv);
+		}
+	} else {
+		i_zval_ptr_dtor(zv);
+	}
 }
 /* }}} */
 
