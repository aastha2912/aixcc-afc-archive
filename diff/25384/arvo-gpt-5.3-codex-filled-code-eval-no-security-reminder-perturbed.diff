--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -217,7 +217,16 @@
 	if (Z_TYPE_P(zv) == IS_INDIRECT) {
 		zv = Z_INDIRECT_P(zv);
 	}
-	i_zval_ptr_dtor(zv);
+
+	/* During unclean shutdown symbol table entries may be corrupted.
+	 * Avoid dereferencing potentially invalid refcounted payloads here.
+	 * We only perform destruction for non-refcounted types and mark the
+	 * slot as undefined in all cases.
+	 */
+	if (!Z_REFCOUNTED_P(zv)) {
+		i_zval_ptr_dtor(zv);
+	}
+	ZVAL_UNDEF(zv);
 }
 /* }}} */
 
