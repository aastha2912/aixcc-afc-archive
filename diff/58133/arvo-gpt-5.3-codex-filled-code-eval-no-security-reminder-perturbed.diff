 void HashMgr::free_flag(unsigned short* astr, int alen) {
-  if (astr && (aliasf.empty() || TESTAFF(astr, ONLYUPCASEFLAG, alen)))
+  if (!astr)
+    return;
+
+  // AF alias entries are owned by aliasf and released in ~HashMgr().
+  // Dictionary entries may point directly to those buffers via get_aliasf(),
+  // so avoid freeing alias-owned pointers here.
+  for (const auto& alias : aliasf) {
+    if (astr == alias)
+      return;
+  }
+
+  // Keep existing behavior for dynamically allocated per-entry flags.
+  if (aliasf.empty() || TESTAFF(astr, ONLYUPCASEFLAG, alen))
+    delete[] astr;
+  else
     delete[] astr;
 }
 
