--- a/xinclude.c
+++ b/xinclude.c
@@ -2235,6 +2235,16 @@
 	    list = list->next;
 
 	    xmlAddPrevSibling(cur, end);
+	    /*
+	     * The replacement can reference namespace declarations owned by
+	     * the include or fallback elements which are freed below.
+	     */
+	    if ((end->type == XML_ELEMENT_NODE) &&
+		(xmlDOMWrapReconcileNamespaces(NULL, end, 0) < 0)) {
+		xmlXIncludeErrMemory(ctxt, cur,
+				     "reconciling namespaces");
+		return(-1);
+	    }
 	}
 	xmlUnlinkNode(cur);
 	xmlFreeNode(cur);
@@ -2265,6 +2275,16 @@
 	while (list != NULL) {
 	    next = list->next;
 	    xmlAddPrevSibling(end, list);
+	    /*
+	     * The fallback node will be freed after its children are moved.
+	     * Preserve namespace bindings inherited from that subtree.
+	     */
+	    if ((list->type == XML_ELEMENT_NODE) &&
+		(xmlDOMWrapReconcileNamespaces(NULL, list, 0) < 0)) {
+		xmlXIncludeErrMemory(ctxt, cur,
+				     "reconciling namespaces");
+		return(-1);
+	    }
 	    list = next;
 	}
 
