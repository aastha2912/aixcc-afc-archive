--- a/xinclude.c
+++ b/xinclude.c
@@ -2191,6 +2191,30 @@
 xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, int nr) {
     xmlNodePtr cur, end, list, tmp;
 
+    /*
+     * Reconcile namespace pointers after moving nodes out of an xi:include
+     * element that might own namespace declarations. If the include node is
+     * freed (XML_PARSE_NOXINCNODE), descendants still referencing namespaces
+     * declared on that node would otherwise keep dangling xmlNs pointers.
+     */
+    static void
+    xmlXIncludeReconciliateNsList(xmlDocPtr doc, xmlNodePtr list) {
+        xmlNodePtr node;
+
+        for (node = list; node != NULL; node = node->next) {
+            if (node->type == XML_ELEMENT_NODE) {
+                xmlNodePtr child;
+
+                xmlReconciliateNs(doc, node);
+                for (child = node->children; child != NULL; child = child->next) {
+                    if (child->type == XML_ELEMENT_NODE) {
+                        xmlXIncludeReconciliateNsList(doc, child);
+                    }
+                }
+            }
+        }
+    }
+
     if (ctxt == NULL)
 	return(-1);
     if ((nr < 0) || (nr >= ctxt->incNr))
@@ -2235,6 +2259,7 @@
 	    list = list->next;
 
 	    xmlAddPrevSibling(cur, end);
+	    xmlXIncludeReconciliateNsList(cur->doc, end);
 	}
 	xmlUnlinkNode(cur);
 	xmlFreeNode(cur);
