--- a/libredwg/src/bits.c
+++ b/libredwg/src/bits.c
@@ -162,7 +162,21 @@
   unsigned char result;
   unsigned char byte;
 
+  /* CHK_OVERFLOW accepts the canonical one-past-end cursor because it is
+     also used after reads that end exactly at EOF.  A reader, however, must
+     have a byte available before dereferencing the chain.  */
   CHK_OVERFLOW (__FUNCTION__, 0)
+  if (dat->byte >= dat->size)
+    {
+      loglevel = dat->opts & DWG_OPTS_LOGLEVEL;
+      LOG_ERROR ("%s buffer overflow at %" PRIuSIZE ".%u >= %" PRIuSIZE,
+                 __FUNCTION__, dat->byte, dat->bit, dat->size)
+#ifdef DWG_ABORT
+      if (++errors > DWG_ABORT_LIMIT)
+        abort ();
+#endif
+      return 0;
+    }
   byte = dat->chain[dat->byte];
   result = (byte & (0x80 >> dat->bit)) >> (7 - dat->bit);
 
