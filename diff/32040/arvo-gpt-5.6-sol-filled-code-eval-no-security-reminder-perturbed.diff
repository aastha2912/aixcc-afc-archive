+/* Compute the size of the four temporary regions without overflowing either
+ * the region size used by the codecs or the allocation size. */
+static int calculate_tmp_sizes(int32_t blocksize, int32_t typesize,
+                               size_t* ebsize, size_t* tmp_nbytes) {
+  const size_t size_max = (size_t)-1;
+
+  if (blocksize <= 0 || typesize <= 0) {
+    return BLOSC2_ERROR_INVALID_PARAM;
+  }
+
+  size_t padding = (size_t)typesize * sizeof(int32_t);
+  if ((size_t)blocksize > size_max - padding) {
+    return BLOSC2_ERROR_INVALID_PARAM;
+  }
+  *ebsize = (size_t)blocksize + padding;
+  if (*ebsize > size_max / 4 || *ebsize > INT32_MAX) {
+    return BLOSC2_ERROR_INVALID_PARAM;
+  }
+  *tmp_nbytes = *ebsize * 4;
+  return 0;
+}
+
