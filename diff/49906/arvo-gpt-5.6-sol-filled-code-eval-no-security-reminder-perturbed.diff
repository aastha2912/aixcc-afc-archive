+static u_int8_t bittorrent_hash_storage_available(const struct ndpi_flow_struct *flow) {
+  /* The BitTorrent hash and TLS state share a union. TLS owns that storage
+   * for TLS.BitTorrent flows, regardless of its position in the stack. */
+  return(flow->detected_protocol_stack[0] != NDPI_PROTOCOL_TLS &&
+	 flow->detected_protocol_stack[1] != NDPI_PROTOCOL_TLS);
+}
